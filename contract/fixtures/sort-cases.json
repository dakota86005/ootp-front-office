{
  "about": "The unknown-last comparator's shared cases (D-056, SWIFTUI_REBUILD.md section 4): a null key is unknown and sorts after every known key in both directions; numbers compare by value, strings by UTF-16 code units, every number before every string (reversed when descending); equal keys and unknown keys keep the order served. Each row is [id, key]; expected lists the ids in order. tests/sortCases.test.ts (a TypeScript reference) and PennantKit's UnknownLastTests run every case.",
  "cases": [
    { "name": "numbers ascending, unknown last", "direction": "ascending",
      "rows": [["a", 3], ["b", null], ["c", 1], ["d", 2]], "expected": ["c", "d", "a", "b"] },
    { "name": "numbers descending, unknown still last", "direction": "descending",
      "rows": [["a", 3], ["b", null], ["c", 1], ["d", 2]], "expected": ["a", "d", "c", "b"] },
    { "name": "several unknowns keep the served order, ascending", "direction": "ascending",
      "rows": [["a", null], ["b", 2], ["c", null], ["d", 1]], "expected": ["d", "b", "a", "c"] },
    { "name": "several unknowns keep the served order, descending", "direction": "descending",
      "rows": [["a", null], ["b", 2], ["c", null], ["d", 1]], "expected": ["b", "d", "a", "c"] },
    { "name": "ties keep the served order, ascending", "direction": "ascending",
      "rows": [["a", 1], ["b", 0], ["c", 1], ["d", 0]], "expected": ["b", "d", "a", "c"] },
    { "name": "ties keep the served order, descending", "direction": "descending",
      "rows": [["a", 1], ["b", 0], ["c", 1], ["d", 0]], "expected": ["a", "c", "b", "d"] },
    { "name": "negative and fractional numbers", "direction": "ascending",
      "rows": [["a", -1.5], ["b", 0], ["c", -10], ["d", 2.25]], "expected": ["c", "a", "b", "d"] },
    { "name": "zero is a value, not unknown, ascending", "direction": "ascending",
      "rows": [["a", null], ["b", 0], ["c", -1]], "expected": ["c", "b", "a"] },
    { "name": "zero is a value, not unknown, descending", "direction": "descending",
      "rows": [["a", null], ["b", 0], ["c", -1]], "expected": ["b", "c", "a"] },
    { "name": "strings by code units: capitals before lower case", "direction": "ascending",
      "rows": [["a", "b"], ["b", "B"], ["c", "a"], ["d", "A"]], "expected": ["d", "b", "c", "a"] },
    { "name": "strings are not read as numbers", "direction": "ascending",
      "rows": [["a", "9"], ["b", "10"], ["c", null]], "expected": ["b", "a", "c"] },
    { "name": "strings descending, unknown last", "direction": "descending",
      "rows": [["a", "9"], ["b", "10"], ["c", null]], "expected": ["a", "b", "c"] },
    { "name": "an empty string is a value", "direction": "ascending",
      "rows": [["a", null], ["b", "a"], ["c", ""]], "expected": ["c", "b", "a"] },
    { "name": "accented letters by code unit", "direction": "ascending",
      "rows": [["a", "é"], ["b", "z"], ["c", "e"]], "expected": ["c", "b", "a"] },
    { "name": "numbers before strings, ascending", "direction": "ascending",
      "rows": [["a", "x"], ["b", 5], ["c", null], ["d", 1]], "expected": ["d", "b", "a", "c"] },
    { "name": "strings before numbers, descending, unknown last", "direction": "descending",
      "rows": [["a", "x"], ["b", 5], ["c", null], ["d", 1]], "expected": ["a", "b", "d", "c"] },
    { "name": "all unknown keeps the served order", "direction": "descending",
      "rows": [["a", null], ["b", null], ["c", null]], "expected": ["a", "b", "c"] }
  ]
}
